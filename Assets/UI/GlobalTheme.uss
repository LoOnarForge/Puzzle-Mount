/* Shared Button Style */
.menu-button {
    font-size: 24px;
    padding: 10px 20px;
    margin: 10px;
    background-color: rgb(45, 45, 45);
    color: white;
    border-radius: 5px;
    border-width: 1px;
    border-color: white;
}

.menu-button:hover {
    background-color: rgb(80, 80, 80);
}

/* Screen Layers */
.overlay-background {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.7);
    justify-content: center;
    align-items: center;
}

/* HUD Icons */
.hud-icons {
    position: absolute;
    top: 20px;
    right: 20px;
    flex-direction: row;
}

.movement-icon {
    width: 64px;
    height: 64px;
}

.sprint-icon {
    width: 64px;
    height: 64px;
    margin-right: 10px;
}
